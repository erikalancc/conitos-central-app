<IfModule mod_mime.c>
  # Manifest de la app instalable (PWA)
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # index.html, el service worker y el manifest siempre frescos: cada versión que se sube se ve al recargar
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La carpeta /api es del API (CodeIgniter): no se toca
  RewriteRule ^api(/|$) - [L]

  # Redirigir cualquier petición a index.html para soportar rutas de React Router
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
